.DS_Store
# Regenerable Blender scratch/intermediate files stay ignored; the PNG/glb
# outputs are the actual site assets gallery.html/viewer.html serve and are
# committed on the publish branch so GH Pages can serve them (a viewer's
# browser cannot run Blender to regenerate them).
renders/*
!renders/*.png
!renders/*.glb
*.blend1
__pycache__/
*.pyc

# Nix GC root — a symlink into /nix/store that stops `nix-collect-garbage`
# deleting the pinned Blender closure. Machine-local, never committed.
# Recreate with: nix-build shell.nix -A blender -o .nix-gcroot-blender
.nix-gcroot-blender
